# Self-hosted Convex connection settings.
# Copy to docker/.env.selfhosted (gitignored) and fill in the admin key:
#   cp docker/.env.selfhosted.example docker/.env.selfhosted
# Generate the key once the backend is running:
#   docker compose exec backend ./generate_admin_key.sh
#
# Keep the quotes around the key: it contains a pipe character, and
# package.json scripts source this file with `set -a`.
# For a remote backend, replace 127.0.0.1 URLs with the public backend origin.
CONVEX_SELF_HOSTED_URL=http://127.0.0.1:3210
CONVEX_SELF_HOSTED_ADMIN_KEY="paste-key-here-keeping-the-quotes"
# Read by `vite` during `pnpm dev:selfhosted` and baked into `vite build`:
VITE_CONVEX_URL=http://127.0.0.1:3210
VITE_CONVEX_SITE_URL=http://127.0.0.1:3211
# auth.config.ts resolves the JWKS domain from this at push time:
CONVEX_SITE_URL=http://127.0.0.1:3211
# Blanked so the cloud CONVEX_DEPLOYMENT in .env.local can't conflict:
CONVEX_DEPLOYMENT=
